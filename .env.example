# open-spri configuration. Copy to .env and adjust. Never commit .env.

# --- Stack -----------------------------------------------------------------
# "proxy" starts the built-in nginx + certbot (all-in-one). Leave empty for an external proxy.
COMPOSE_PROFILES=proxy

# --- Database --------------------------------------------------------------
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Public address and certificate (proxy/certbot) --------------------------
# DNS name under which partners reach the S/PRI endpoint. "localhost" disables Let's Encrypt.
PUBLIC_HOSTNAME=localhost
# Let's Encrypt account e-mail (optional).
ACME_EMAIL=
# true = Let's Encrypt staging (untrusted test certificates, no rate limits). Set to false for production.
ACME_STAGING=true
# false = keep the temporary self-signed certificate (local tests only).
ACME_ENABLED=true
# ecdsa (P-256, default) or rsa (3072 bit). Both satisfy the AK S&P security requirements.
ACME_KEY_TYPE=ecdsa
HTTP_PORT=80
HTTPS_PORT=443

# --- Master key -------------------------------------------------------------
# Encrypts the WS-Security signing key that the setup wizard stores in the database.
# Generate once with: openssl rand -base64 32   - and keep a backup: without it the stored key is lost.
OPENSPRI_MASTER_KEY=

# --- S/PRI (SOAP) ------------------------------------------------------------
# WS-Security signing key, see docs/betrieb.md ("Signaturschlüssel"). File in ./secrets/.
# OPENSPRI_SOAP_SIGNING_KEYSTORE=/run/openspri/spri-signature.p12
# OPENSPRI_SOAP_SIGNING_KEYSTORE_PASSWORD=
# Public URL of the S/PRI endpoint written into the WSDL (default: https://PUBLIC_HOSTNAME/spri/v4)
# OPENSPRI_SOAP_PUBLISHED_ENDPOINT_URL=
# Egress proxy with fixed outbound IP for requests to partners (optional), e.g. http://proxy:3128
# SPRI_OUTBOUND_PROXY=

# Message code table (Anlage 5): export from the AK Confluence, place it in ./config/, see docs/betrieb.md.
# OPENSPRI_MESSAGE_CODES_FILE=/etc/openspri/SPRI_Meldungscodetabelle.csv
# Anlage 1 check of inbound requests: report (default, accept and record) or enforce (TEQ 0995), ADR-0006.
# OPENSPRI_SOAP_ATTRIBUTE_RULES_INBOUND=report

# --- Delivery and notifications (docs/betrieb.md) ------------------------------
# OPENSPRI_OUTBOX_RETRY_INTERVAL=5m
# OPENSPRI_OUTBOX_MAX_ATTEMPTS=12
# SPRING_MAIL_HOST=smtp.example.de
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# OPENSPRI_NOTIFICATIONS_FROM=open-spri@example.de
# OPENSPRI_NOTIFICATIONS_OPERATOR_EMAIL=betrieb@example.de

# --- Images ----------------------------------------------------------------
# OPENSPRI_VERSION=local
# Digest of the running api image; certified builds are recognised by it (see README).
# OPENSPRI_BUILD_DIGEST=
