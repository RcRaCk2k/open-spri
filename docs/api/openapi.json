{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Öffentliche REST-API von open-spri. Das Web-Frontend nutzt ausschließlich diese API. Ausführliche Beschreibung mit Beispielen: docs/api/ im Repository.",
    "license" : {
      "name" : "MIT",
      "url" : "https://github.com/RcRaCk2k/open-spri/blob/main/LICENSE"
    },
    "title" : "open-spri REST-API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "diese Instanz"
  } ],
  "tags" : [ {
    "description" : "Version, Build und Zustand der Instanz",
    "name" : "Betrieb"
  }, {
    "description" : "Long-Life-Tokens für externe Systeme (CRM, Workflow)",
    "name" : "API-Tokens"
  }, {
    "description" : "Anmeldung der Web-Oberfläche und Informationen zur aktuellen Anmeldung",
    "name" : "Anmeldung"
  }, {
    "description" : "Ersteinrichtung einer neuen Installation (geschützt durch das Setup-Token aus dem Log)",
    "name" : "Setup"
  }, {
    "description" : "Firmendaten, Optionen und Signaturschlüssel",
    "name" : "Einstellungen"
  }, {
    "description" : "Lokale Benutzer der Web-Oberfläche",
    "name" : "Benutzer"
  } ],
  "paths" : {
    "/api/v1/about" : {
      "get" : {
        "description" : "Liefert Softwareversion, implementierte S/PRI-Version und ob die Instanz in einem zertifizierten Build läuft. Der Aufruf ist ohne Anmeldung möglich.",
        "operationId" : "about",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AboutResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Version und Build der Instanz",
        "tags" : [ "Betrieb" ]
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "description" : "Prüft Benutzername und Passwort und legt eine Sitzung an (Cookie, SameSite=Strict). Externe Systeme verwenden statt dessen API-Tokens.",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Anmelden (Web-Oberfläche)",
        "tags" : [ "Anmeldung" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "description" : "Beendet die Sitzung der Web-Oberfläche.",
        "operationId" : "logout",
        "responses" : {
          "200" : {
            "content" : { },
            "description" : "OK"
          }
        },
        "summary" : "Abmelden",
        "tags" : [ "Anmeldung" ]
      }
    },
    "/api/v1/auth/me" : {
      "get" : {
        "description" : "Wer ist angemeldet und mit welchen Berechtigungen.",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Aktuelle Anmeldung",
        "tags" : [ "Anmeldung" ]
      }
    },
    "/api/v1/auth/modules" : {
      "get" : {
        "description" : "Die in dieser Instanz aktiven Anmeldeverfahren. Ohne Anmeldung aufrufbar.",
        "operationId" : "modules",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ModuleResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Anmeldeverfahren",
        "tags" : [ "Anmeldung" ]
      }
    },
    "/api/v1/settings" : {
      "get" : {
        "operationId" : "get",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CompanySettingsDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Firmendaten und Optionen",
        "tags" : [ "Einstellungen" ]
      },
      "put" : {
        "operationId" : "put",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CompanySettingsDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CompanySettingsDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Firmendaten und Optionen ändern",
        "tags" : [ "Einstellungen" ]
      }
    },
    "/api/v1/settings/signing-key" : {
      "get" : {
        "description" : "Inklusive PEM zur Weitergabe an Partner.",
        "operationId" : "signingKey",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SigningKeyInfo"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Unser Signaturzertifikat",
        "tags" : [ "Einstellungen" ]
      },
      "post" : {
        "description" : "Erzeugt einen neuen Schlüssel oder übernimmt einen PKCS#12-Keystore. Wirkt sofort für alle neuen Nachrichten. Das neue Zertifikat muss allen Partnern vorab mitgeteilt werden (Partner hinterlegen mehrere Zertifikate während des Wechsels).",
        "operationId" : "newSigningKey",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewSigningKey"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SigningKeyInfo"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Signaturschlüssel wechseln",
        "tags" : [ "Einstellungen" ]
      }
    },
    "/api/v1/setup" : {
      "get" : {
        "description" : "Ohne Anmeldung aufrufbar. Die Oberfläche zeigt bei `completed=false` den Setup-Assistenten.",
        "operationId" : "status",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SetupStatus"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Stand der Ersteinrichtung",
        "tags" : [ "Setup" ]
      },
      "post" : {
        "description" : "Legt den ersten Administrator, die Firmendaten (inkl. ITU Carrier Code) und den Signaturschlüssel an. Nur einmal möglich und nur mit dem Setup-Token aus dem Container-Log (Header `X-Setup-Token`).",
        "operationId" : "complete",
        "parameters" : [ {
          "description" : "einmaliges Setup-Token aus dem Container-Log",
          "in" : "header",
          "name" : "X-Setup-Token",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SetupStatus"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Ersteinrichtung abschließen",
        "tags" : [ "Setup" ]
      }
    },
    "/api/v1/tokens" : {
      "get" : {
        "operationId" : "list_1",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TokenResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Tokens auflisten",
        "tags" : [ "API-Tokens" ]
      },
      "post" : {
        "description" : "Das Geheimnis wird nur in der Antwort angezeigt; gespeichert wird ausschließlich sein Hash.",
        "operationId" : "create_1",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateTokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CreatedTokenResponse"
                }
              }
            },
            "description" : "Created"
          }
        },
        "summary" : "Token anlegen",
        "tags" : [ "API-Tokens" ]
      }
    },
    "/api/v1/tokens/{id}" : {
      "delete" : {
        "description" : "Wirkt sofort.",
        "operationId" : "revoke",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Token widerrufen",
        "tags" : [ "API-Tokens" ]
      }
    },
    "/api/v1/users" : {
      "get" : {
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/UserResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Benutzer auflisten",
        "tags" : [ "Benutzer" ]
      },
      "post" : {
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            },
            "description" : "Created"
          }
        },
        "summary" : "Benutzer anlegen",
        "tags" : [ "Benutzer" ]
      }
    },
    "/api/v1/users/{id}" : {
      "patch" : {
        "description" : "Name, Rolle, Sperre oder Passwort.",
        "operationId" : "update",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateUserRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Benutzer ändern",
        "tags" : [ "Benutzer" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AboutResponse" : {
        "type" : "object",
        "description" : "Version und Build der Instanz",
        "properties" : {
          "buildDigest" : {
            "type" : [ "string", "null" ],
            "description" : "Digest des laufenden Container-Images, falls bekannt",
            "example" : "sha256:3f1c…"
          },
          "certifiedBuild" : {
            "type" : "boolean",
            "description" : "true, wenn buildDigest zu einem Build gehört, der den Konformitätstest bestanden hat"
          },
          "name" : {
            "type" : "string",
            "description" : "Produktname",
            "example" : "open-spri"
          },
          "spriVersion" : {
            "type" : "string",
            "description" : "Implementierte S/PRI-Version (Major.Minor)",
            "example" : "4.4"
          },
          "version" : {
            "type" : "string",
            "description" : "Softwareversion (SemVer)",
            "example" : "1.0.0"
          }
        },
        "required" : [ "certifiedBuild", "name", "spriVersion", "version" ]
      },
      "AdminAccount" : {
        "type" : "object",
        "description" : "Erster Administrator",
        "properties" : {
          "displayName" : {
            "type" : "string",
            "example" : "Administration"
          },
          "password" : {
            "type" : "string",
            "description" : "mindestens 12 Zeichen"
          },
          "username" : {
            "type" : "string",
            "example" : "admin"
          }
        },
        "required" : [ "displayName", "password", "username" ]
      },
      "CompanySettingsDto" : {
        "type" : "object",
        "description" : "Firmendaten und Optionen",
        "properties" : {
          "carrierCode" : {
            "type" : "string",
            "description" : "ITU Carrier Code (ICC), 1–6 Großbuchstaben/Ziffern",
            "example" : "BSPGMB"
          },
          "city" : {
            "type" : [ "string", "null" ]
          },
          "connectivityEnabled" : {
            "type" : "boolean"
          },
          "contactEmail" : {
            "type" : "string",
            "description" : "Empfänger für Ausfall- und Wartungsmeldungen",
            "example" : "betrieb@example.de"
          },
          "diagEnabled" : {
            "type" : "boolean"
          },
          "estEnabled" : {
            "type" : "boolean"
          },
          "name" : {
            "type" : "string",
            "example" : "Beispiel GmbH"
          },
          "postalCode" : {
            "type" : [ "string", "null" ]
          },
          "publicSpriEndpoint" : {
            "type" : [ "string", "null" ],
            "description" : "Öffentliche Adresse unseres S/PRI-Endpunkts (für die WSDL)",
            "example" : "https://spri.example.de/spri/v4"
          },
          "roleAuftraggeber" : {
            "type" : "boolean",
            "description" : "Wir bestellen bei Partnern"
          },
          "roleLeistungserbringer" : {
            "type" : "boolean",
            "description" : "Wir bieten eigene Leitungen an"
          },
          "street" : {
            "type" : [ "string", "null" ]
          },
          "thirdPartyOrdersEnabled" : {
            "type" : "boolean"
          },
          "wbciMode" : {
            "type" : "string",
            "enum" : [ "SERVICE_PROVIDER", "OWN_INTERFACE", "NONE" ]
          }
        },
        "required" : [ "carrierCode", "contactEmail", "name", "roleAuftraggeber", "roleLeistungserbringer" ]
      },
      "CreateTokenRequest" : {
        "type" : "object",
        "description" : "Neues Token",
        "properties" : {
          "expiresAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "Optional: Ablaufzeitpunkt; ohne Angabe gilt das Token bis zum Widerruf"
          },
          "name" : {
            "type" : "string",
            "example" : "CRM Produktion"
          },
          "role" : {
            "type" : "string",
            "description" : "Rolle; bestimmt die maximal möglichen Berechtigungen",
            "enum" : [ "ADMIN", "OPERATOR_AG", "OPERATOR_LE", "VIEWER", "INTEGRATION" ],
            "example" : "INTEGRATION"
          },
          "scopes" : {
            "type" : [ "array", "null" ],
            "description" : "Optional: Einschränkung auf einen Teil der Berechtigungen der Rolle",
            "example" : [ "orders:read" ],
            "items" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "name", "role" ]
      },
      "CreateUserRequest" : {
        "type" : "object",
        "description" : "Neuer Benutzer",
        "properties" : {
          "displayName" : {
            "type" : "string",
            "example" : "Max Muster"
          },
          "password" : {
            "type" : "string",
            "description" : "mindestens 12 Zeichen"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "ADMIN", "OPERATOR_AG", "OPERATOR_LE", "VIEWER", "INTEGRATION" ],
            "example" : "OPERATOR_LE"
          },
          "username" : {
            "type" : "string",
            "example" : "m.muster"
          }
        },
        "required" : [ "displayName", "password", "role", "username" ]
      },
      "CreatedTokenResponse" : {
        "type" : "object",
        "description" : "Das neue Token. `token` enthält das Geheimnis und wird nur in dieser Antwort angezeigt.",
        "properties" : {
          "details" : {
            "$ref" : "#/components/schemas/TokenResponse"
          },
          "token" : {
            "type" : "string",
            "example" : "spri_Ab3dE7fG_…"
          }
        },
        "required" : [ "details", "token" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "description" : "Anmeldedaten",
        "properties" : {
          "password" : {
            "type" : "string",
            "example" : "ein-langes-passwort"
          },
          "username" : {
            "type" : "string",
            "example" : "admin"
          }
        },
        "required" : [ "password", "username" ]
      },
      "MeResponse" : {
        "type" : "object",
        "description" : "Die angemeldete Person bzw. das Token",
        "properties" : {
          "kind" : {
            "type" : "string",
            "description" : "USER, TOKEN, SETUP"
          },
          "name" : {
            "type" : "string"
          },
          "scopes" : {
            "type" : "array",
            "description" : "Berechtigungen",
            "items" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "kind", "name", "scopes" ]
      },
      "ModuleResponse" : {
        "type" : "object",
        "description" : "Ein verfügbares Anmeldeverfahren",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "example" : "local-users"
          },
          "interactiveLogin" : {
            "type" : "boolean",
            "description" : "true, wenn das Verfahren eine Anmeldung in der Oberfläche anbietet"
          }
        },
        "required" : [ "displayName", "id", "interactiveLogin" ]
      },
      "NewSigningKey" : {
        "type" : "object",
        "description" : "Neuen Signaturschlüssel erzeugen oder übernehmen",
        "properties" : {
          "commonName" : {
            "type" : [ "string", "null" ]
          },
          "pkcs12Base64" : {
            "type" : [ "string", "null" ]
          },
          "pkcs12Password" : {
            "type" : [ "string", "null" ]
          }
        }
      },
      "SetupRequest" : {
        "type" : "object",
        "description" : "Alle Angaben der Ersteinrichtung; wird in einem Schritt übernommen",
        "properties" : {
          "admin" : {
            "$ref" : "#/components/schemas/AdminAccount"
          },
          "company" : {
            "$ref" : "#/components/schemas/CompanySettingsDto"
          },
          "signingKey" : {
            "$ref" : "#/components/schemas/SigningKeyChoice",
            "description" : "ohne Angabe wird ein neuer Schlüssel erzeugt"
          }
        },
        "required" : [ "admin", "company" ]
      },
      "SetupStatus" : {
        "type" : "object",
        "description" : "Stand der Ersteinrichtung",
        "properties" : {
          "completed" : {
            "type" : "boolean"
          },
          "signingKeySource" : {
            "type" : "string",
            "description" : "Herkunft des aktuellen Signaturschlüssels: KEYSTORE_FILE, DATABASE, TEMPORARY"
          }
        },
        "required" : [ "completed", "signingKeySource" ]
      },
      "SigningKeyChoice" : {
        "type" : "object",
        "description" : "Signaturschlüssel: neu erzeugen (Standard) oder einen vorhandenen PKCS#12-Keystore übernehmen",
        "properties" : {
          "commonName" : {
            "type" : [ "string", "null" ],
            "description" : "Name im Zertifikat beim Erzeugen",
            "example" : "S/PRI Signatur Beispiel GmbH"
          },
          "generate" : {
            "type" : "boolean",
            "description" : "true: neuen Schlüssel erzeugen (RSA 3072, selbstsigniert)",
            "example" : true
          },
          "pkcs12Base64" : {
            "type" : [ "string", "null" ],
            "description" : "PKCS#12-Keystore (Base64) zum Übernehmen"
          },
          "pkcs12Password" : {
            "type" : [ "string", "null" ],
            "description" : "Passwort des Keystores"
          }
        }
      },
      "SigningKeyInfo" : {
        "type" : "object",
        "description" : "Unser Signaturzertifikat (WS-Security). Das PEM geht an jeden Partner.",
        "properties" : {
          "certificatePem" : {
            "type" : "string"
          },
          "issuer" : {
            "type" : "string"
          },
          "keyBits" : {
            "type" : "integer",
            "format" : "int32"
          },
          "notAfter" : {
            "type" : "string",
            "format" : "date-time"
          },
          "serialNumber" : {
            "type" : "string",
            "description" : "dezimal, wie im Feld signaturId/serial"
          },
          "source" : {
            "type" : "string",
            "description" : "KEYSTORE_FILE, DATABASE, TEMPORARY"
          },
          "subject" : {
            "type" : "string"
          }
        },
        "required" : [ "certificatePem", "issuer", "keyBits", "notAfter", "serialNumber", "source", "subject" ]
      },
      "TokenResponse" : {
        "type" : "object",
        "description" : "Ein API-Token. Das Geheimnis wird nie wieder angezeigt.",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "createdBy" : {
            "type" : "string"
          },
          "expiresAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "id" : {
